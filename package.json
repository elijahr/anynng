{
  "name": "@axiomantic/anynng",
  "version": "0.2.0",
  "description": "[EXPERIMENTAL] Pure Nim 2.0 / Nimony implementation of NNG v2.1.0 Scalability Protocols with C-ABI & WebAssembly/TypeScript bindings",
  "repository": {
    "type": "git",
    "url": "https://github.com/elijahr/anynng.git"
  },
  "homepage": "https://github.com/elijahr/anynng",
  "bugs": {
    "url": "https://github.com/elijahr/anynng/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bash scripts/compile_wasm.sh && tsc",
    "compile:wasm": "bash scripts/compile_wasm.sh",
    "compile:ts": "tsc",
    "pretest": "bash scripts/compile_wasm.sh",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "fmt": "npx prettier --write 'ts/**/*.ts' 'tests/**/*.ts'"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "license": "MIT"
}
